# Development Dockerfile with hot reload
FROM node:20-alpine

WORKDIR /app

# Install dependencies for hot reload
RUN npm install -g vite

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm install

# Copy source code
COPY . .

# Expose Vite default port
EXPOSE 5173

# Start development server
CMD ["npm", "run", "dev", "--", "--host"]